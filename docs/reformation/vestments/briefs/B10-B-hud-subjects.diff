 local COB = ChurchOfBeef
 
 -- Event Mode Fight HUD (Bible §10.7, §19.2 / §19.3). Compact spectator card.
--- Appears at sanction. Persists through the verdict beat: remember the last
--- sanctioned pair and keep painting it after GetSanctioned() is nil while
--- Runtime is still not QUIET (favor frozen on the last split). Hide on QUIET
--- / EndEvent / no last pair. A new Sanction replaces the remembered pair.
--- No verdict qualifier. Defined fallback: everything except live health.
--- Favor split is Pope-local from Gora, or congregation broadcast only.
+-- Appears at sanction. Congregation pair arrives as Runtime subjects.fighters
+-- (STATE); they never Sanction locally. livePair is GetSanctioned(), else
+-- subjects.fighters with two ids. Remember it as lastPair. Persist lastPair
+-- when both Gora and Runtime fighters are empty and the event is still live
+-- (B9-E). Hide on QUIET / EndEvent / no last pair. A new live pair replaces
+-- the remembered pair. No verdict qualifier. Defined fallback: everything
+-- except live health. Favor split is Pope-local from Gora (gora pair only,
+-- so a Runtime leftover after a ruling does not thaw the freeze), or
+-- congregation broadcast only.
 -- Dress is stock iron/parchment (QuestBG + WHITE8X8 + tooltip border). Thin
 -- parchment fields sit behind name+title. Center is a stock ring, not a
 -- faction crest. Mute rails are decorative, not live HP. Defense count is
@@ -194,12 +197,31 @@
   return type(snap) == "table" and snap.state ~= "QUIET"
 end
 
-local function livePair()
+local function goraPair()
   if not COB.Gora or not COB.Gora.GetSanctioned then return nil end
   local pair = COB.Gora:GetSanctioned()
   if type(pair) ~= "table" then return nil end
   if pair.fighterA == nil or pair.fighterB == nil then return nil end
   return pair
+end
+
+local function runtimePair()
+  if not COB.Runtime or not COB.Runtime.Snapshot then return nil end
+  local snap = COB.Runtime:Snapshot()
+  if type(snap) ~= "table" then return nil end
+  local subjects = snap.subjects
+  if type(subjects) ~= "table" then return nil end
+  local fighters = subjects.fighters
+  if type(fighters) ~= "table" then return nil end
+  local a, b = fighters[1], fighters[2]
+  if type(a) ~= "number" or type(b) ~= "number" then return nil end
+  return { fighterA = a, fighterB = b }
+end
+
+local function livePair()
+  local gora = goraPair()
+  if gora then return gora end
+  return runtimePair()
 end
 
 local function localSender()
