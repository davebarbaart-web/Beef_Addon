+    stipulation = pair.stipulation,
+  }
+end
+
+local function displayPair()
+  local live = livePair()
+  if live then
+    rememberPair(live)
+    return live
+  end
+  local subjects = subjectsPair()
+  if subjects then
+    rememberPair(subjects)
+    return subjects
+  end
+  if lastPair then
+    return lastPair
+  end
+  return nil
+end
