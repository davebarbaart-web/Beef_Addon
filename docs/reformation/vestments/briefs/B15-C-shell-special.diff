# B15-C — Quiet shell UISpecialFrames dedupe (implementation diff)

Lane-only unified diff of the exclusive implementation files vs the pre-lane working tree.

--- a/addon/ChurchOfBeef/UI/MainFrame.lua
+++ b/addon/ChurchOfBeef/UI/MainFrame.lua
@@ -465,6 +465,16 @@
   restorePoint(frame)
   return frame, content
 end
 
+-- Named Quiet shell on UISpecialFrames (scan then append). Missing table
+-- no-ops. No panel whoosh on ESC / show / hide.
+local function rememberSpecial(name)
+  if type(UISpecialFrames) ~= "table" then return end
+  for i = 1, #UISpecialFrames do
+    if UISpecialFrames[i] == name then return end
+  end
+  UISpecialFrames[#UISpecialFrames + 1] = name
+end
+
 --------------------------------------------------------------------------------
 -- Lifecycle
 --------------------------------------------------------------------------------
@@ -510,9 +520,7 @@
     if ui then ui.shown = false end
   end)
 
-  if type(UISpecialFrames) == "table" then
-    table.insert(UISpecialFrames, FRAME_NAME)
-  end
+  rememberSpecial(FRAME_NAME)
 
   self:OnStatusChanged()

