diff --git a/tests/test_markers.lua b/tests/test_markers.lua
--- a/tests/test_markers.lua
+++ b/tests/test_markers.lua
@@ -198,6 +198,9 @@
 assert_true(src:find("pcall(TargetUnit", 1, true) ~= nil, "TargetUnit is pcalled")
