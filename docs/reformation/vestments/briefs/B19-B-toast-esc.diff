# B19-B — Small toast ESC via UISpecialFrames (implementation diff)

Lane-only unified diff of the exclusive implementation files vs the pre-lane working tree.

--- a/addon/ChurchOfBeef/UI/Toasts.lua
+++ b/addon/ChurchOfBeef/UI/Toasts.lua
@@ -793,6 +793,16 @@
 
   self.frame = frame
   self.showing = nil
+  -- After the initial Hide so create does not fire OnHide teardown.
+  if type(frame.SetScript) == "function" then
+    local existing = type(frame.GetScript) == "function" and frame:GetScript("OnHide")
+    if not existing then
+      frame:SetScript("OnHide", function()
+        self.showing = nil
+      end)
+    end
+  end
+  rememberSpecial("ChurchOfBeefToast")
   return frame
 end
 

