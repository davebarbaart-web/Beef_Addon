# B20-D — ESC on the small toast advances the queue (implementation diff)

Lane-only unified diff of the exclusive implementation files vs the pre-lane working tree.

--- a/addon/ChurchOfBeef/UI/Toasts.lua
+++ b/addon/ChurchOfBeef/UI/Toasts.lua
@@ -411,6 +411,10 @@
 pump = function(self)
   local nextEnv = table.remove(pending, 1)
   if not nextEnv then
+    -- Hide-from-empty-pump re-enters OnHide; do not loop.
+    if not self.showing and #pending == 0 then
+      return
+    end
     self.showing = nil
     if self.frame then self.frame:Hide() end
     return
@@ -797,7 +801,13 @@
     local existing = type(frame.GetScript) == "function" and frame:GetScript("OnHide")
     if not existing then
       frame:SetScript("OnHide", function()
-        self.showing = nil
+        -- Hide-from-empty-pump: already idle; do not re-enter.
+        if not self.showing and #pending == 0 then
+          return
+        end
+        bumpGen()
+        self.showing = nil
+        pump(self)
       end)
     end
   end

