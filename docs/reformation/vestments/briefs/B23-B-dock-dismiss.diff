diff --git a/addon/ChurchOfBeef/UI/ConsoleDock.lua b/addon/ChurchOfBeef/UI/ConsoleDock.lua
--- a/addon/ChurchOfBeef/UI/ConsoleDock.lua
+++ b/addon/ChurchOfBeef/UI/ConsoleDock.lua
@@ -6,8 +6,11 @@
 -- local player is the registered Pope. Stock SANCTION calls
 -- Console:Sanction when present. Expand calls Console:Show.
 -- ESC Hide()s ChurchOfBeefConsoleDock via UISpecialFrames (deduped).
--- Hide is not EndEvent. No Quiet chrome. No whisper fan-out. No cue.
--- No congregation bar.
+-- OnHide (after create-time Hide) remembers dismiss while the event
+-- is live and sets lastView.shown false. Refresh does not re-show
+-- while dismissed. Show() clears dismiss. Quiet / not-mayShow clears
+-- dismiss. Hide is not EndEvent. No Quiet chrome. No whisper fan-out.
+-- No cue. No congregation bar.
 local ConsoleDock = {
   MODE = "Event",
 }
@@ -28,6 +31,7 @@
 
 local frame = nil
 local lastView = nil
+local dismissed = false
 
 local function deepcopy(value)
   if type(value) ~= "table" then return value end
@@ -173,6 +177,20 @@
   widget:SetHeight(HEIGHT)
   restorePoint(widget)
   widget:Hide()
+
+  -- After the initial Hide so create does not fire OnHide teardown.
+  if type(widget.SetScript) == "function" then
+    local existing = type(widget.GetScript) == "function" and widget:GetScript("OnHide")
+    if not existing then
+      widget:SetScript("OnHide", function()
+        if lastView == nil then lastView = hiddenView() end
+        lastView.shown = false
+        if eventLive() then
+          dismissed = true
+        end
+      end)
+    end
+  end
 
   if widget.TitleText and widget.TitleText.SetText then
     widget.TitleText:SetText(TITLE)
@@ -234,13 +252,27 @@
     lastView = hiddenView()
     lastView.shown = false
     lastView.pope = isLocalPope()
+    if not mayShow() then
+      dismissed = false
+    end
     return self:GetView()
   end
-  paint(mayShow())
+  if not mayShow() then
+    dismissed = false
+    paint(false)
+    dismissed = false
+    return self:GetView()
+  end
+  if dismissed then
+    paint(false)
+    return self:GetView()
+  end
+  paint(true)
   return self:GetView()
 end
 
 function ConsoleDock:Show()
+  dismissed = false
   if not frame then
     self:Init()
   end
@@ -262,11 +294,13 @@
 
 function ConsoleDock:ResetForTests()
   if not COB._IN_TEST then return false end
+  dismissed = false
   lastView = hiddenView()
   lastView.shown = false
   if frame then
     frame:Hide()
     frame = nil
   end
+  dismissed = false
   return true
 end

diff --git a/tests/test_console_dock.lua b/tests/test_console_dock.lua
