# B23-C — Init early-return re-registers the small toast special frame (implementation diff)

Lane-only unified diff of the exclusive implementation files vs the pre-lane working tree.

--- a/addon/ChurchOfBeef/UI/Toasts.lua
+++ b/addon/ChurchOfBeef/UI/Toasts.lua
@@ -752,7 +752,10 @@
 --------------------------------------------------------------------------------
 
 function Toasts:Init()
-  if self.frame then return self.frame end
+  if self.frame then
+    rememberSpecial("ChurchOfBeefToast")
+    return self.frame
+  end
   if type(CreateFrame) ~= "function" then return nil end
 
   local frame = CreateFrame("Frame", "ChurchOfBeefToast", UIParent, "BackdropTemplate")

