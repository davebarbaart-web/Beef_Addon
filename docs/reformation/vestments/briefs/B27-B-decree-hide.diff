# B27-B — Decree Hide blanks leftover paint when the line is gone (implementation diff)

Lane-only unified diff of the exclusive implementation files vs the pre-lane working tree.

--- a/addon/ChurchOfBeef/UI/Decree.lua
+++ b/addon/ChurchOfBeef/UI/Decree.lua
@@ -316,8 +316,13 @@
 end
 
 function DecreeBanner:Hide()
-  if self.frame then self.frame:Hide() end
+  if self.frame then
+    if not getDecree() then
+      wipePaint(self.frame)
+    end
+    self.frame:Hide()
+  end
   return true
 end
 
 function DecreeBanner:GetView()

