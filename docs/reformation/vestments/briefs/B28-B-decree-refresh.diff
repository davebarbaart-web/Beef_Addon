# B28-B — Decree Refresh hides leftover paint when the line is gone (implementation diff)

Lane-only unified diff of the exclusive implementation files vs the pre-lane working tree.

--- a/addon/ChurchOfBeef/UI/Decree.lua
+++ b/addon/ChurchOfBeef/UI/Decree.lua
@@ -335,3 +335,18 @@
     flavor = decree and decree.flavor or nil,
   }
 end
+
+function DecreeBanner:Refresh()
+  local frame = ensureFrame()
+  if not frame then return false end
+  local decree = getDecree()
+  if not decree then
+    wipePaint(frame)
+    frame:Hide()
+    return false
+  end
+  if self:IsShown() then
+    paint(frame, decree)
+    return true
+  end
+  return false
+end

