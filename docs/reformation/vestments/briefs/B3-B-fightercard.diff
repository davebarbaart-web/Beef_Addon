diff --git a/addon/ChurchOfBeef/UI/FighterCard.lua b/addon/ChurchOfBeef/UI/FighterCard.lua
new file mode 100644
--- /dev/null
+++ b/addon/ChurchOfBeef/UI/FighterCard.lua
@@ -0,0 +1,429 @@
+ChurchOfBeef = ChurchOfBeef or {}
+local COB = ChurchOfBeef
+
+-- Event Mode mute fighter card (Bible §10.6). Tale of the tape.
+-- The card shows; the Pope tells. Hidden in Quiet / no pair.
+-- Stock QuestBG + WHITE8X8. Center-third, two facing plates.
+-- No live health. No sound. No generated flavor.
+local FighterCard = {
+  MODE = "Event",
+}
+COB.FighterCard = FighterCard
+
+local FRAME_NAME = "ChurchOfBeefFighterCard"
+local FALLBACK_W, FALLBACK_H = 420, 220
+local WHITE8X8 = "Interface\\Buttons\\WHITE8X8"
+local PARCHMENT_TEXTURE = "Interface\\QuestFrame\\QuestBG"
+local SEAL_TEXTURE = "Interface\\Buttons\\UI-EmptySlot-White"
+
+local INK = { r = 0.95, g = 0.88, b = 0.70 }
+local MUTED = { r = 0.55, g = 0.50, b = 0.42 }
+local SEAL_GOLD = { r = 0.85, g = 0.72, b = 0.28 }
+
+local frame = nil
+local lastView = nil
+
+local function deepcopy(value)
+  if type(value) ~= "table" then return value end
+  local out = {}
+  for k, v in pairs(value) do
+    out[deepcopy(k)] = deepcopy(v)
+  end
+  return out
+end
+
+local function hiddenView()
+  return {
+    shown = false,
+    mode = "Event",
+    fighterA = nil,
+    fighterB = nil,
+    headToHead = nil,
+    stipulation = nil,
+    health = nil,
+  }
+end
+
+local function applyTexture(tex, path)
+  if not tex or type(path) ~= "string" or not tex.SetTexture then return false end
+  local ok = pcall(tex.SetTexture, tex, path)
+  if ok then
+    tex._cobTexture = path
+    return true
+  end
+  return false
+end
+
+local function fill(tex, r, g, b, a)
+  if not tex then return end
+  if not applyTexture(tex, WHITE8X8) and tex.SetColorTexture then
+    tex:SetColorTexture(r, g, b, a or 1)
+  elseif tex.SetVertexColor then
+    tex:SetVertexColor(r, g, b, a or 1)
+  end
+  tex._cobColor = { r = r, g = g, b = b, a = a or 1 }
+end
+
+local function applyParchment(tex)
+  if not tex then return end
+  if applyTexture(tex, PARCHMENT_TEXTURE) then return end
+  fill(tex, 0.78, 0.70, 0.52, 0.94)
+end
+
+local function tintSeal(tex)
+  if not tex then return end
+  if not applyTexture(tex, SEAL_TEXTURE) then
+    fill(tex, SEAL_GOLD.r, SEAL_GOLD.g, SEAL_GOLD.b, 1)
+    return
+  end
+  if tex.SetVertexColor then
+    tex:SetVertexColor(SEAL_GOLD.r, SEAL_GOLD.g, SEAL_GOLD.b, 1)
+  end
+  tex._cobColor = { r = SEAL_GOLD.r, g = SEAL_GOLD.g, b = SEAL_GOLD.b, a = 1 }
+end
+
+local function tint(fs, color)
+  if not fs or type(color) ~= "table" then return end
+  local r, g, b = color.r, color.g, color.b
+  if type(r) ~= "number" or type(g) ~= "number" or type(b) ~= "number" then return end
+  if fs.SetTextColor then fs:SetTextColor(r, g, b) end
+  fs._cobColor = { r = r, g = g, b = b }
+end
+
+local function classFile(class)
+  if type(class) ~= "string" then return nil end
+  local file = class:gsub("%s+", ""):upper()
+  if file == "" then return nil end
+  return file
+end
+
+local function classColor(class)
+  if type(RAID_CLASS_COLORS) ~= "table" then return nil end
+  local file = classFile(class)
+  local c = file and RAID_CLASS_COLORS[file]
+  if type(c) ~= "table" or type(c.r) ~= "number" then return nil end
+  return { r = c.r, g = c.g, b = c.b }
+end
+
+local function churchTitle(characterId)
+  if not COB.Store or not COB.Store.RankForCharacter then return nil end
+  local rankId = COB.Store:RankForCharacter(characterId)
+  if rankId == nil then return nil end
+  if not (COB.Ranks and COB.Ranks.Title) then return nil end
+  local title = COB.Ranks.Title(rankId)
+  if type(title) ~= "string" or title == "" or title == "Unknown" then return nil end
+  return title
+end
+
+local function livePair()
+  if not COB.Gora or not COB.Gora.GetSanctioned then return nil end
+  local pair = COB.Gora:GetSanctioned()
+  if type(pair) ~= "table" then return nil end
+  if pair.fighterA == nil or pair.fighterB == nil then return nil end
+  return pair
+end
+
+local function headToHeadFor(character, opponentId)
+  if type(character) ~= "table" or type(character.gora) ~= "table" then return nil end
+  local list = character.gora.headToHeads
+  if type(list) ~= "table" then return nil end
+  for i = 1, #list do
+    local row = list[i]
+    if type(row) == "table" and row.opponentId == opponentId then
+      local fights = row.fights
+      if type(fights) == "number" and fights > 0 then
+        return {
+          wins = row.wins or 0,
+          losses = row.losses or 0,
+          fights = fights,
+        }
+      end
+    end
+  end
+  return nil
+end
+
+local function fighterFrom(id)
+  local ch = COB.Store and COB.Store.GetCharacter and COB.Store:GetCharacter(id) or nil
+  if type(ch) ~= "table" then
+    return {
+      id = id,
+      name = "",
+      level = nil,
+      title = nil,
+      wins = 0,
+      losses = 0,
+      nameColor = nil,
+    }
+  end
+  local gora = type(ch.gora) == "table" and ch.gora or {}
+  return {
+    id = id,
+    name = ch.name,
+    class = ch.class,
+    level = ch.level,
+    title = churchTitle(id),
+    wins = gora.wins or 0,
+    losses = gora.losses or 0,
+    nameColor = classColor(ch.class),
+  }
+end
+
+local function recordText(fighter)
+  return tostring(fighter.wins or 0) .. "-" .. tostring(fighter.losses or 0)
+end
+
+local function levelText(fighter)
+  if type(fighter.level) ~= "number" then return "" end
+  return tostring(fighter.level)
+end
+
+local function popeLine(pair)
+  if type(pair) ~= "table" then return nil end
+  local line = pair.stipulation
+  if type(line) ~= "string" or line == "" then return nil end
+  return line
+end
+
+local function paintFighter(plate, fighter)
+  plate.name:SetText(fighter.name or "")
+  plate.level:SetText(levelText(fighter))
+  plate.title:SetText(fighter.title or "")
+  plate.record:SetText(recordText(fighter))
+  tint(plate.name, fighter.nameColor or INK)
+  tint(plate.level, MUTED)
+  tint(plate.title, INK)
+  tint(plate.record, MUTED)
+end
+
+local function paintHidden()
+  lastView = hiddenView()
+  if not frame then return lastView end
+  frame.plateA.name:SetText("")
+  frame.plateB.name:SetText("")
+  frame.plateA.level:SetText("")
+  frame.plateB.level:SetText("")
+  frame.plateA.title:SetText("")
+  frame.plateB.title:SetText("")
+  frame.plateA.record:SetText("")
+  frame.plateB.record:SetText("")
+  frame.headToHead:SetText("")
+  if frame.headToHead.Hide then frame.headToHead:Hide() end
+  frame.stipulation:SetText("")
+  if frame.stipulation.Hide then frame.stipulation:Hide() end
+  frame:Hide()
+  return lastView
+end
+
+local function paintShown(pair)
+  local fighterA = fighterFrom(pair.fighterA)
+  local fighterB = fighterFrom(pair.fighterB)
+  local h2h = nil
+  if COB.Store and COB.Store.GetCharacter then
+    local chA = COB.Store:GetCharacter(pair.fighterA)
+    h2h = headToHeadFor(chA, pair.fighterB)
+  end
+  local stipulation = popeLine(pair)
+
+  paintFighter(frame.plateA, fighterA)
+  paintFighter(frame.plateB, fighterB)
+  if h2h then
+    frame.headToHead:SetText(recordText(h2h))
+    if frame.headToHead.Show then frame.headToHead:Show() end
+  else
+    frame.headToHead:SetText("")
+    if frame.headToHead.Hide then frame.headToHead:Hide() end
+  end
+  if stipulation then
+    frame.stipulation:SetText(stipulation)
+    if frame.stipulation.Show then frame.stipulation:Show() end
+  else
+    frame.stipulation:SetText("")
+    if frame.stipulation.Hide then frame.stipulation:Hide() end
+  end
+
+  lastView = {
+    shown = true,
+    mode = "Event",
+    fighterA = fighterA,
+    fighterB = fighterB,
+    headToHead = h2h,
+    stipulation = stipulation,
+    health = nil,
+  }
+  frame:Show()
+  return lastView
+end
+
+local function cardWidth()
+  local parent = UIParent
+  local w = parent and parent.GetWidth and parent:GetWidth()
+  if type(w) == "number" and w > 0 then
+    return math.floor(w / 3)
+  end
+  return FALLBACK_W
+end
+
+local function cardHeight()
+  local parent = UIParent
+  local h = parent and parent.GetHeight and parent:GetHeight()
+  if type(h) == "number" and h > 0 then
+    local third = math.floor(h / 3)
+    if third < FALLBACK_H then return third end
+    return FALLBACK_H
+  end
+  return FALLBACK_H
+end
+
+local function makeLabel(parent, template, justify)
+  local fs = parent:CreateFontString(nil, "OVERLAY", template or "GameFontNormal")
+  if fs.SetJustifyH and justify then fs:SetJustifyH(justify) end
+  return fs
+end
+
+local function buildPlate(parent, justify)
+  local plate = CreateFrame("Frame", nil, parent)
+  plate.parchment = plate:CreateTexture(nil, "BACKGROUND")
+  if plate.parchment.SetAllPoints then plate.parchment:SetAllPoints(plate) end
+  applyParchment(plate.parchment)
+  plate.name = makeLabel(plate, "GameFontHighlight", justify)
+  plate.title = makeLabel(plate, "GameFontNormal", justify)
+  plate.level = makeLabel(plate, "GameFontNormal", justify)
+  plate.record = makeLabel(plate, "GameFontNormal", justify)
+  return plate
+end
+
+local function build()
+  local parent = UIParent
+  local width, height = cardWidth(), cardHeight()
+  local widget = CreateFrame("Frame", FRAME_NAME, parent, "BackdropTemplate")
+  widget:SetSize(width, height)
+  widget:SetClampedToScreen(true)
+  if widget.EnableMouse then widget:EnableMouse(false) end
+  if widget.SetFrameStrata then widget:SetFrameStrata("DIALOG") end
+  widget:SetPoint("CENTER", parent, "CENTER", 0, 0)
+  if widget.SetBackdrop then
+    widget:SetBackdrop({
+      bgFile = WHITE8X8,
+      edgeFile = "Interface\\Tooltips\\UI-Tooltip-Border",
+      tile = true,
+      tileSize = 8,
+      edgeSize = 12,
+      insets = { left = 3, right = 3, top = 3, bottom = 3 },
+    })
+    if widget.SetBackdropColor then
+      widget:SetBackdropColor(0.06, 0.05, 0.04, 0.92)
+    end
+    if widget.SetBackdropBorderColor then
+      widget:SetBackdropBorderColor(0.65, 0.55, 0.35, 1)
+    end
+  end
+
+  widget.iron = widget:CreateTexture(nil, "BACKGROUND")
+  if widget.iron.SetAllPoints then widget.iron:SetAllPoints(widget) end
+  fill(widget.iron, 0.06, 0.05, 0.04, 0.94)
+
+  widget.parchment = widget:CreateTexture(nil, "BACKGROUND")
+  if widget.parchment.ClearAllPoints then widget.parchment:ClearAllPoints() end
+  widget.parchment:SetPoint("TOPLEFT", widget, "TOPLEFT", 5, -5)
+  widget.parchment:SetPoint("BOTTOMRIGHT", widget, "BOTTOMRIGHT", -5, 5)
+  applyParchment(widget.parchment)
+
+  widget.goldRule = widget:CreateTexture(nil, "ARTWORK")
+  widget.goldRule:SetPoint("TOPLEFT", widget, "TOPLEFT", 8, -3)
+  widget.goldRule:SetPoint("TOPRIGHT", widget, "TOPRIGHT", -8, -3)
+  if widget.goldRule.SetHeight then widget.goldRule:SetHeight(1) end
+  fill(widget.goldRule, 0.65, 0.55, 0.35, 0.90)
+
+  widget.seal = widget:CreateTexture(nil, "ARTWORK")
+  widget.seal:SetSize(28, 28)
+  widget.seal:SetPoint("TOP", widget, "TOP", 0, -4)
+  tintSeal(widget.seal)
+
+  local plateW = math.floor((width - 56) / 2)
+  local plateH = height - 56
+  widget.plateA = buildPlate(widget, "LEFT")
+  widget.plateB = buildPlate(widget, "RIGHT")
+  widget.plateA:SetSize(plateW, plateH)
+  widget.plateB:SetSize(plateW, plateH)
+  widget.plateA:SetPoint("LEFT", widget, "LEFT", 12, -8)
+  widget.plateB:SetPoint("RIGHT", widget, "RIGHT", -12, -8)
+
+  widget.plateA.name:SetPoint("TOPLEFT", widget.plateA, "TOPLEFT", 8, -8)
+  widget.plateB.name:SetPoint("TOPRIGHT", widget.plateB, "TOPRIGHT", -8, -8)
+  widget.plateA.title:SetPoint("TOPLEFT", widget.plateA.name, "BOTTOMLEFT", 0, -4)
+  widget.plateB.title:SetPoint("TOPRIGHT", widget.plateB.name, "BOTTOMRIGHT", 0, -4)
+  widget.plateA.level:SetPoint("TOPLEFT", widget.plateA.title, "BOTTOMLEFT", 0, -4)
+  widget.plateB.level:SetPoint("TOPRIGHT", widget.plateB.title, "BOTTOMRIGHT", 0, -4)
+  widget.plateA.record:SetPoint("TOPLEFT", widget.plateA.level, "BOTTOMLEFT", 0, -4)
+  widget.plateB.record:SetPoint("TOPRIGHT", widget.plateB.level, "BOTTOMRIGHT", 0, -4)
+
+  widget.vs = makeLabel(widget, "GameFontNormal", "CENTER")
+  widget.vs:SetPoint("CENTER", widget, "CENTER", 0, 8)
+  widget.vs:SetText("VS")
+  tint(widget.vs, MUTED)
+
+  widget.headToHead = makeLabel(widget, "GameFontNormal", "CENTER")
+  widget.headToHead:SetPoint("TOP", widget.vs, "BOTTOM", 0, -4)
+  widget.headToHead:Hide()
+
+  widget.stipulation = makeLabel(widget, "GameFontNormal", "CENTER")
+  widget.stipulation:SetPoint("BOTTOM", widget, "BOTTOM", 0, 12)
+  widget.stipulation:Hide()
+
+  widget:Hide()
+  return widget
+end
+
+function FighterCard:Init()
+  if not frame then
+    frame = build()
+  end
+  self:Refresh()
+  return frame
+end
+
+function FighterCard:GetView()
+  if lastView == nil then lastView = hiddenView() end
+  return deepcopy(lastView)
+end
+
+function FighterCard:Refresh()
+  if not frame then
+    self:Init()
+    return self:GetView()
+  end
+  local pair = livePair()
+  if not pair then
+    paintHidden()
+    return self:GetView()
+  end
+  paintShown(pair)
+  return self:GetView()
+end
+
+function FighterCard:Show()
+  if not frame then
+    self:Init()
+  end
+  local pair = livePair()
+  if not pair then
+    paintHidden()
+    return false
+  end
+  paintShown(pair)
+  return true
+end
+
+function FighterCard:Hide()
+  paintHidden()
+end
+
+function FighterCard:ResetForTests()
+  if not COB._IN_TEST then return false end
+  lastView = hiddenView()
+  if frame then
+    paintHidden()
+  end
+  return true
+end

diff --git a/tests/test_fighter_card.lua b/tests/test_fighter_card.lua
new file mode 100644
--- /dev/null
+++ b/tests/test_fighter_card.lua
@@ -0,0 +1,507 @@
+-- Mute fighter cards (Bible §10.6). Isolated: wow_ui_stub + Common + Ranks +
+-- Store + Runtime + Gora + FighterCard. Event Mode only. No live health, no
+-- sound, no generated flavor. Standalone wrap. No TOC / bootstrap / run.lua.
+package.path = package.path .. ";./tests/?.lua"
+
+local stub = require("wow_ui_stub")
+local restore = stub.install()
+
+ChurchOfBeef = ChurchOfBeef or {}
+ChurchOfBeef._IN_TEST = true
+
+local standalone = (type(assert_eq) ~= "function")
+local passed = 0
+local failed = 0
+
+if standalone then
+  function assert_eq(a, b, msg)
+    if a ~= b then
+      failed = failed + 1
+      print("FAIL: " .. (msg or "") .. " expected " .. tostring(b) .. " got " .. tostring(a))
+    else
+      passed = passed + 1
+    end
+  end
+  function assert_true(v, msg)
+    assert_eq(not not v, true, msg)
+  end
+end
+
+dofile("addon/ChurchOfBeef/Core/Common.lua")
+dofile("addon/ChurchOfBeef/Data/Ranks.lua")
+dofile("addon/ChurchOfBeef/Core/Store.lua")
+dofile("addon/ChurchOfBeef/Core/Runtime.lua")
+dofile("addon/ChurchOfBeef/Core/Gora.lua")
+dofile("addon/ChurchOfBeef/UI/FighterCard.lua")
+
+local COB = ChurchOfBeef
+local FighterCard = COB.FighterCard
+local Gora = COB.Gora
+local Store = COB.Store
+local Runtime = COB.Runtime
+local Ranks = COB.Ranks
+
+local sounds = 0
+PlaySound = function()
+  sounds = sounds + 1
+end
+PlaySoundFile = function()
+  sounds = sounds + 1
+end
+
+local healthReads = 0
+UnitHealth = function()
+  healthReads = healthReads + 1
+  return 100
+end
+UnitHealthMax = function()
+  healthReads = healthReads + 1
+  return 100
+end
+CombatLogGetCurrentEventInfo = function()
+  healthReads = healthReads + 1
+end
+C_NamePlate = {
+  GetNamePlates = function()
+    healthReads = healthReads + 1
+    return {}
+  end,
+}
+
+local function reset()
+  assert_eq(Store:ResetForTests(), true, "Store ResetForTests runs under _IN_TEST")
+  assert_eq(Runtime:ResetForTests(), true, "Runtime ResetForTests runs under _IN_TEST")
+  assert_eq(Gora:ResetForTests(), true, "Gora ResetForTests runs under _IN_TEST")
+  assert_eq(FighterCard:ResetForTests(), true, "FighterCard ResetForTests runs under _IN_TEST")
+  sounds = 0
+  healthReads = 0
+end
+
+local function twoChars(fieldsA, fieldsB)
+  local a = Store:CreateCharacter(fieldsA or { name = "Chuckroast", class = "Warrior", level = 70 })
+  local b = Store:CreateCharacter(fieldsB or { name = "Tendermage", class = "Mage", level = 68 })
+  return a, b
+end
+
+local function rankBoth(charA, charB, rankA, rankB)
+  local humanA = Store:CreateHuman({ name = "Chuck" })
+  local humanB = Store:CreateHuman({ name = "Tender" })
+  Store:LinkCharacter(charA.id, humanA.id)
+  Store:LinkCharacter(charB.id, humanB.id)
+  Store:SetRank(humanA.id, rankA or 3)
+  Store:SetRank(humanB.id, rankB or 1)
+  return humanA, humanB
+end
+
+local function sanctionPair(stipulation)
+  reset()
+  Runtime:StartEvent()
+  local a, b = twoChars()
+  rankBoth(a, b, 3, 1)
+  local pair = Gora:Sanction(a.id, b.id, stipulation)
+  return a, b, pair
+end
+
+local function findStatusBar(widget)
+  if widget._type == "StatusBar" then return widget end
+  for i = 1, #(widget._children or {}) do
+    local hit = findStatusBar(widget._children[i])
+    if hit then return hit end
+  end
+  return nil
+end
+
+local function countType(widget, frameType)
+  local n = 0
+  if widget._type == frameType then n = n + 1 end
+  for i = 1, #(widget._children or {}) do
+    n = n + countType(widget._children[i], frameType)
+  end
+  return n
+end
+
+local function sameRgb(color, sample)
+  return color and sample
+    and color.r == sample.r and color.g == sample.g and color.b == sample.b
+end
+
+--------------------------------------------------------------------------------
+-- Isolated surface. Other modules stay nil only when this file is the process.
+--------------------------------------------------------------------------------
+assert_true(FighterCard ~= nil, "FighterCard is loaded")
+assert_true(Store ~= nil, "Store is loaded")
+assert_true(Runtime ~= nil, "Runtime is loaded")
+assert_true(Gora ~= nil, "Gora is loaded")
+assert_true(Ranks ~= nil, "Ranks is loaded for Church titles")
+assert_true(COB.Names ~= nil, "Common name law is loaded")
+
+if standalone then
+  assert_eq(COB.Net, nil, "isolated suite does not load BeefNet")
+  assert_eq(COB.UI, nil, "isolated suite does not load the Quiet shell")
+  assert_eq(COB.Toasts, nil, "isolated suite does not load Toasts")
+  assert_eq(COB.DB, nil, "isolated suite does not load DB")
+  assert_eq(COB.Officer, nil, "isolated suite does not load Officer")
+  assert_eq(COB.Archive, nil, "isolated suite does not load Archive")
+  assert_eq(COB.Recognition, nil, "isolated suite does not load Recognition")
+  assert_eq(COB.Sender, nil, "isolated suite does not load Sender")
+  assert_eq(COB.Codec, nil, "isolated suite does not load Codec")
+  assert_eq(COB.Snapshot, nil, "isolated suite does not load Snapshot")
+  assert_eq(COB.Knighting, nil, "isolated suite does not load Knighting")
+  assert_eq(COB.Minimap, nil, "isolated suite does not load Minimap")
+  assert_eq(COB.Console, nil, "isolated suite does not load Console")
+  assert_eq(COB.Hud, nil, "isolated suite does not load Hud")
+  assert_eq(COB.Sound, nil, "isolated suite does not load Sound")
+  assert_eq(COB.DecreeBanner, nil, "isolated suite does not load Decree")
+  assert_eq(COB.RecordsBook, nil, "isolated suite does not load Records Book")
+end
+
+assert_eq(FighterCard.MODE, "Event", "card declares Event Mode")
+assert_eq(type(FighterCard.Init), "function", "Init builds the surface")
+assert_eq(type(FighterCard.Show), "function", "Show needs a sanctioned pair")
+assert_eq(type(FighterCard.Hide), "function", "Hide dismisses the card")
+assert_eq(type(FighterCard.Refresh), "function", "Refresh paints from Core")
+assert_eq(type(FighterCard.GetView), "function", "GetView returns a copy")
+assert_eq(type(FighterCard.ResetForTests), "function", "ResetForTests is a harness hatch")
+assert_eq(FighterCard.GetHealth, nil, "no health getter")
+assert_eq(FighterCard.ScrapeHealth, nil, "no health scrape")
+assert_eq(FighterCard.PlayCue, nil, "no sound this lane")
+assert_eq(FighterCard.Toast, nil, "card is not a toast")
+assert_eq(FighterCard.Announce, nil, "software does not announce")
+assert_eq(FighterCard.Narrate, nil, "software does not narrate")
+assert_eq(FighterCard.Sanction, nil, "card does not sanction")
+assert_eq(FighterCard.DeclareVictor, nil, "card does not record outcomes")
+assert_eq(FighterCard.Favor, nil, "no favor economy table")
+assert_eq(FighterCard.INPUT, nil, "no invented INPUT channel")
+
+--------------------------------------------------------------------------------
+-- Source contract: mute tape. No scrape, no sound, no flavor strings.
+--------------------------------------------------------------------------------
+local srcFile = io.open("addon/ChurchOfBeef/UI/FighterCard.lua", "r")
+assert_true(srcFile ~= nil, "FighterCard.lua is readable")
+local src = srcFile:read("*a")
+srcFile:close()
