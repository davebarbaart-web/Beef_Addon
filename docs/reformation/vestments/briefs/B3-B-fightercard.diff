+--------------------------------------------------------------------------------
+-- Center-third when UIParent size is known. Not a full-screen toast.
+--------------------------------------------------------------------------------
+UIParent:SetWidth(1024)
+UIParent:SetHeight(768)
+dofile("addon/ChurchOfBeef/UI/FighterCard.lua")
+FighterCard = COB.FighterCard
