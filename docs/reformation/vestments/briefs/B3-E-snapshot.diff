diff --git a/addon/ChurchOfBeef/Net/BeefNet.lua b/addon/ChurchOfBeef/Net/BeefNet.lua
--- a/addon/ChurchOfBeef/Net/BeefNet.lua
+++ b/addon/ChurchOfBeef/Net/BeefNet.lua
@@ -12,7 +12,7 @@
 -- INPUT is live only for favor whisper-to-Pope. Petition and confession stay
 -- unknown. Outbound STATE / SNAPSHOT / DECREE send only if the local player is
 -- a registered Pope (always false until the #8 list — do not code it).
--- SendFavor is congregation whisper and is not Pope-gated.
+-- SendFavor and RequestSnapshot are congregation whisper and are not Pope-gated.
 --
 -- Classic+ port notes: the client APIs read here are behind type() guards and listed
 -- below, so a host that renames one degrades to "cannot send" instead of erroring on
@@ -385,6 +385,26 @@
     return false, err
   end
   return self:_TransmitWhisper(payload, target)
 end
+
+-- Congregation → Pope. Not Pope-gated. Caller supplies the whisper target.
+-- Do not look up a Pope name.
+function Net:RequestSnapshot(target, nowSeconds)
+  if type(target) ~= "string" or target == "" then
+    return false, "no target"
+  end
+  local payload, err
+  if COB.Snapshot and COB.Snapshot.Request then
+    payload, err = COB.Snapshot:Request()
+  elseif COB.Codec and COB.Codec.EncodeSnapshot then
+    payload, err = COB.Codec:EncodeSnapshot({ role = "request" })
+  else
+    return false, "no codec"
+  end
+  if not payload then
+    return false, err
+  end
+  return self:_TransmitWhisper(payload, target)
+end
 
