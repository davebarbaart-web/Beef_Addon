@@ -196,6 +196,7 @@
 assert_eq(type(Net.SendSnapshot), "function", "SendSnapshot exists")
 assert_eq(type(Net.SendDecree), "function", "SendDecree exists")
 assert_eq(type(Net.SendFavor), "function", "SendFavor exists")
