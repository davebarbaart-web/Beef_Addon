# B30-A — Decree ensureFrame remounts a missing OnHide (implementation diff)

Lane-only unified diff of the exclusive implementation files vs the pre-lane working tree.

--- a/addon/ChurchOfBeef/UI/Decree.lua
+++ b/addon/ChurchOfBeef/UI/Decree.lua
@@ -284,7 +284,8 @@
 local function ensureFrame()
   if DecreeBanner.frame then
     rememberSpecial(FRAME_NAME)
+    wireDecreeOnHide(DecreeBanner.frame)
     return DecreeBanner.frame
   end
   if type(CreateFrame) ~= "function" then return nil end

