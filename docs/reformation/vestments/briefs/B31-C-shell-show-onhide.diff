# B31-C — Quiet shell Show remounts a missing OnHide (implementation diff)

Lane-only unified diff of the exclusive implementation files vs the pre-lane working tree.

--- a/addon/ChurchOfBeef/UI/MainFrame.lua
+++ b/addon/ChurchOfBeef/UI/MainFrame.lua
@@ -593,6 +593,8 @@
 function UI:Show()
   if not self.frame then self:Init() end
   if not self.frame then return end
+  wireShellOnHide(self.frame)
+  rememberSpecial(FRAME_NAME)
   self.frame:Show()
   self:OnStatusChanged()
 end
--- a/tests/test_ui.lua
+++ b/tests/test_ui.lua
@@ -8,7 +8,8 @@
