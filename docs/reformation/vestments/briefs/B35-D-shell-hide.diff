+  assert_eq(ChurchOfBeefDB.ui.shown, false,
+    "Hide remount persists shown = false")
+  assert_eq(COB.UI.frame, existingHideShell, "Hide remount does not rebuild")
+  assert_eq(COB.UI.frame:GetScript("OnShow"), hideOnShow,
