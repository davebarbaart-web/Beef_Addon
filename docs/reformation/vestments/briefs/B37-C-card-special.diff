+    assert_true(type(remAt) == "number" and type(wireAt) == "number" and remAt < wireAt,
+      "Hide remounts rememberSpecial before OnHide remount")
+    assert_true(type(wireAt) == "number" and type(paintAt) == "number" and wireAt < paintAt,
