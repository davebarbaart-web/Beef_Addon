+snap.eventId = 2
+assert_eq(#Knighting:GetLine(), 0, "a new eventId expires the prior line")
+local newEnq = Knighting:Enqueue(steve.id)
+assert_true(newEnq ~= nil, "a new event accepts a fresh Enqueue")
