+local function applyHeadlineFont(fs)
+  if not fs then return end
+  local used = false
+  if fs.SetFont then
+    local ok, applied = pcall(fs.SetFont, fs, HEADLINE_FONT, HEADLINE_SIZE)
+    used = ok and applied and true or false
+  end
+  if not used and fs.SetFontObject then
+    local font = GameFontNormalLarge
+    if type(font) == "string" then font = _G[font] end
+    if font then pcall(fs.SetFontObject, fs, font) end
+  end
+end
+
+-- First clerical line is the display-face headline; the rest is body.
+local function splitHeadline(text)
+  if type(text) ~= "string" then return "", "" end
+  local nl = string.find(text, "\n", 1, true)
+  if not nl then return text, "" end
+  return string.sub(text, 1, nl - 1), string.sub(text, nl + 1)
+end
+
