+local function paintHonorific(fs, text)
+  if type(text) == "string" and text ~= "" then
+    fs:SetText(text)
+    if fs.Show then fs:Show() end
+  else
+    fs:SetText("")
+    if fs.Hide then fs:Hide() end
+  end
+  tint(fs, MUTED)
+end
