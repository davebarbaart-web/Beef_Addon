+--------------------------------------------------------------------------------
+-- Theatrical overlay (sanction / verdict / cowardice)
+--------------------------------------------------------------------------------
+
+local function theaterAllowed()
+  local runtime = COB.Runtime
+  if type(runtime) ~= "table" or type(runtime.Snapshot) ~= "function" then
+    return false
+  end
+  local snap = runtime:Snapshot()
+  local state = type(snap) == "table" and snap.state or nil
+  if state == nil or state == "QUIET" then
+    return false
+  end
+  return true
+end
+
+local function clericalCopy(kind, fields)
+  if type(fields) ~= "table" then fields = {} end
+
+  if kind == "sanction" then
+    local a, b = fields.fighterA, fields.fighterB
+    if type(a) ~= "string" or a == "" or type(b) ~= "string" or b == "" then
+      return nil
+    end
+    local lines = { "A Beef Gora is Sanctioned", a, "VS", b }
+    if type(fields.stipulation) == "string" and fields.stipulation ~= "" then
+      lines[#lines + 1] = fields.stipulation
+    end
+    return table.concat(lines, "\n")
+  end
+
+  if kind == "cowardice" then
+    local name = fields.name
+    if type(name) ~= "string" or name == "" then return nil end
+    return "Cowardice recorded: " .. name .. ". So ruled by the Beef Pope."
+  end
+
+  if kind == "verdict" then
+    local ruling = fields.ruling
+    if ruling == "victor" then
+      local name = fields.name
+      if type(name) ~= "string" or name == "" then return nil end
+      return "Victor declared: " .. name .. "."
+    end
+    if ruling == "void" then
+      return "Void."
+    end
+    if ruling == "free" then
+      local text = fields.text
+      if type(text) == "string" and text ~= "" then return text end
+      return "Free ruling."
+    end
+  end
+
+  return nil
+end
+
+local function tintFor(kind, fields)
+  if kind == "cowardice" then return OXBLOOD end
+  if kind == "verdict" and fields.ruling == "victor" then return GOLD end
+  return IRON
+end
+
+local function panelWidth()
+  local parentW
+  if UIParent and UIParent.GetWidth then
+    parentW = UIParent:GetWidth()
+  end
+  if type(parentW) == "number" and parentW > 0 then
+    return math.floor(parentW / 3)
+  end
+  return PANEL_FALLBACK_W
+end
+
+local function playTheaterCue(kind)
+  local sound = COB.Sound
+  if type(sound) ~= "table" or type(sound.Play) ~= "function" then return end
+  pcall(function()
+    sound:Play(kind)
+  end)
+end
+
+local function hideTheater(self)
+  theaterGen = theaterGen + 1
+  local t = self.theater
+  if t and t.root then t.root:Hide() end
+end
+
+local function tryTheaterBackdrop(frame)
+  if frame.SetBackdrop then
+    frame:SetBackdrop({
+      bgFile = "Interface\\QuestFrame\\QuestBG",
+      edgeFile = "Interface\\Tooltips\\UI-Tooltip-Border",
+      tile = false,
+      edgeSize = 16,
+      insets = { left = 4, right = 4, top = 4, bottom = 4 },
+    })
+    if frame.SetBackdropColor then
+      frame:SetBackdropColor(1, 1, 1, 1)
+    end
+    if frame.SetBackdropBorderColor then
+      frame:SetBackdropBorderColor(0.65, 0.55, 0.35, 1)
+    end
+    return true
+  end
+  return false
+end
+
+function Toasts:InitTheater()
+  if self.theater and self.theater.root then return self.theater end
+  if type(CreateFrame) ~= "function" then return nil end
+
+  local root = CreateFrame("Frame", "ChurchOfBeefProclaim", UIParent)
+  root:SetFrameStrata("FULLSCREEN_DIALOG")
+  if root.EnableMouse then root:EnableMouse(false) end
+  if root.SetAllPoints then
+    root:SetAllPoints(UIParent)
+  else
+    root:SetPoint("TOPLEFT", UIParent, "TOPLEFT", 0, 0)
+    root:SetPoint("BOTTOMRIGHT", UIParent, "BOTTOMRIGHT", 0, 0)
+  end
+  root:Hide()
+
+  local dim = root:CreateTexture(nil, "BACKGROUND")
+  dim:SetAllPoints(root)
+  if dim.SetColorTexture then
+    dim:SetColorTexture(0, 0, 0, DIM_ALPHA)
+  else
+    dim:SetTexture("Interface\\Buttons\\WHITE8X8")
+    if dim.SetVertexColor then dim:SetVertexColor(0, 0, 0, DIM_ALPHA) end
+  end
+
+  local panel = CreateFrame("Frame", "ChurchOfBeefProclaimPanel", root, "BackdropTemplate")
+  if not panel then
+    panel = CreateFrame("Frame", "ChurchOfBeefProclaimPanel", root)
+  end
+  if panel.EnableMouse then panel:EnableMouse(false) end
+  if not tryTheaterBackdrop(panel) then
+    local parchment = panel:CreateTexture(nil, "BACKGROUND")
+    parchment:SetAllPoints(panel)
+    parchment:SetTexture("Interface\\QuestFrame\\QuestBG")
+  end
+
+  local tint = panel:CreateTexture(nil, "OVERLAY")
+  tint:SetTexture("Interface\\Buttons\\WHITE8X8")
+  tint:SetPoint("BOTTOMLEFT", panel, "BOTTOMLEFT", 8, 8)
+  tint:SetPoint("BOTTOMRIGHT", panel, "BOTTOMRIGHT", -8, 8)
+  tint:SetHeight(6)
+
+  local copy = panel:CreateFontString(nil, "OVERLAY", "GameFontNormalLarge")
+  copy:SetPoint("TOPLEFT", panel, "TOPLEFT", 16, -16)
+  copy:SetPoint("BOTTOMRIGHT", panel, "BOTTOMRIGHT", -16, 20)
+  copy:SetJustifyH("CENTER")
+  copy:SetJustifyV("MIDDLE")
+  if copy.SetWordWrap then copy:SetWordWrap(true) end
+
+  self.theater = {
+    root = root,
+    dim = dim,
+    panel = panel,
+    tint = tint,
+    copy = copy,
+    dimAlpha = DIM_ALPHA,
+  }
+  return self.theater
+end
+
+--- Event Mode proclamation / verdict / cowardice. Clerical copy only.
+--- fields: { fighterA, fighterB, name, ruling, text, stipulation }
+--- @return ok boolean, reason string|nil
+function Toasts:Proclaim(kind, fields)
+  if type(kind) ~= "string" or not THEATER_KINDS[kind] then
+    return false, "invalid"
+  end
+  if not theaterAllowed() then
+    return false, "quiet"
+  end
+
+  fields = type(fields) == "table" and fields or {}
+  local text = clericalCopy(kind, fields)
+  if type(text) ~= "string" or text == "" then
+    return false, "invalid"
+  end
+
+  local theater = self:InitTheater()
+  if not theater then return false, "invalid" end
+
+  local w = panelWidth()
+  local lines = 1
+  for _ in text:gmatch("\n") do lines = lines + 1 end
+  theater.panel:SetWidth(w)
+  theater.panel:SetHeight(math.max(140, 48 + lines * 24))
+  if theater.panel.ClearAllPoints then theater.panel:ClearAllPoints() end
+  theater.panel:SetPoint("CENTER", UIParent, "CENTER", 0, 0)
+
+  theater.copy:SetText(text)
+  theater.dimAlpha = DIM_ALPHA
+  if theater.dim.SetColorTexture then
+    theater.dim:SetColorTexture(0, 0, 0, DIM_ALPHA)
+  elseif theater.dim.SetVertexColor then
+    theater.dim:SetVertexColor(0, 0, 0, DIM_ALPHA)
+  end
+
+  local color = tintFor(kind, fields)
+  if theater.tint and theater.tint.SetVertexColor then
+    theater.tint:SetVertexColor(color[1], color[2], color[3], color[4] or 1)
+  end
+
+  theater.root:Show()
+  theater.panel:Show()
+
+  if DEFAULT_CHAT_FRAME and DEFAULT_CHAT_FRAME.AddMessage then
+    DEFAULT_CHAT_FRAME:AddMessage(text)
+  end
+
+  playTheaterCue(kind)
+
+  theaterGen = theaterGen + 1
+  local myGen = theaterGen
+  after(THEATER_HOLD, function()
+    if theaterGen ~= myGen then return end
+    if theater.root then theater.root:Hide() end
+  end)
+
+  return true
+end
