+}
+
+local function toRoman(n)
+  if type(n) ~= "number" then return "" end
+  n = math.floor(n)
+  if n < 1 or n > 3999 then return "" end
+  local parts = {}
+  for i = 1, #ROMAN_MAP do
+    local value = ROMAN_MAP[i][1]
+    local glyph = ROMAN_MAP[i][2]
+    while n >= value do
+      parts[#parts + 1] = glyph
+      n = n - value
+    end
+  end
+  return table.concat(parts)
+end
+
+RecordsBook.toRoman = toRoman
+
+local function displayCount(n)
+  if type(n) ~= "number" then n = 0 end
+  return toRoman(n)
+end
+
+local function applyParchment(tex)
+  if not tex then return end
+  local used = false
+  if tex.SetTexture then
+    local ok = pcall(tex.SetTexture, tex, PARCHMENT_TEXTURE)
+    used = ok and true or false
+  end
+  if not used then
+    fill(tex, 0.78, 0.70, 0.52, 0.94)
+  end
+end
+
+local function tomeHeight()
+  local parent = UIParent
+  local h = parent and parent.GetHeight and parent:GetHeight()
+  if type(h) == "number" and h > 0 then
+    return math.floor(h * 0.7 + 0.5)
+  end
+  return 480
+end
