  # HybridScrollFrame
```
<UI>
   <Frame name="HybridScrollFrameItem" mixin="HybridScrollFrameItemMixin" virtual="true"  enableMouse="true">
       <Size x="196" y="60"/>
       <Layers>
           <Layer level="BACKGROUND">
               <Texture parentKey="Background" atlas="Garr_ListButton" useAtlasSize="false">
                   <Size x="196" y="60"/>
                   <Anchors>
                       <Anchor point="CENTER"/>
                   </Anchors>
               </Texture>
           </Layer>
           <Layer level="OVERLAY">
               <FontString parentKey="Subject" inherits="GameFontNormal" justifyH="CENTER">
                   <Size x="160" y="50"/>
                   <Color r="1" g="1" b="1"/>
                   <Anchors>
                       <Anchor point="CENTER" x="0" y="0"/>
                   </Anchors>
               </FontString>
           </Layer>
       </Layers>
   </Frame>
</UI>
```

